#!/bin/sh

echo "🛡️  [Pre-Push] Running Pint Linter & Pest Tests..."

echo "🔍 Checking code styling with Laravel Pint..."
vendor/bin/pint --test
if [ $? -ne 0 ]; then
    echo "❌ Pint style check failed! Run 'composer lint' to auto-fix code style before pushing."
    exit 1
fi

echo "🧪 Running full Pest test suite..."
vendor/bin/pest --test-directory=src/Tests --ci --colors=always
if [ $? -ne 0 ]; then
    echo "❌ Pest test suite failed! Push aborted."
    exit 1
fi

echo "✅ All pre-push checks passed successfully!"
exit 0